<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- Minimum 3.5.x patch release fixing CVE-2026-41001 and managed Spring Framework/Data advisories. -->
        <version>3.5.15</version>
        <relativePath/>
    </parent>

    <groupId>pl.wsb</groupId>
    <!-- LAB 01: dopisz nazwę projektu (taką samą jak pakiet pl.wsb.schoolio), np. wdtb-2026-backend-kawiarnia -->
<artifactId>wdtb-2026-backend-schoolio</artifactId>    <!-- LAB 01: wpisz numery indeksów osób z zespołu, np. 1.0.0-123456-123457-123458 (reguła R1.05) -->
    <version>1.0.0-113667-113577-113500</version>
    <name>WdTB-2026-Backend</name>
    <description>Projekt zespołowy z przedmiotu Wprowadzenie do technologii backendowych (WdTB)</description>

    <properties>
        <java.version>25</java.version>
        <!-- CVE-driven overrides: Boot 3.5.15 does not yet manage these patched releases.
             Jackson: CVE-2026-59888, CVE-2026-59889, CVE-2026-54512 through
             CVE-2026-54518, CVE-2026-77310, CVE-2026-83557, CVE-2026-68497,
             CVE-2026-19032, CVE-2026-91776, CVE-2026-91777, CVE-2026-89407,
             CVE-2026-89425, CVE-2026-68494.
             Log4j: CVE-2026-49844. Tomcat: CVE-2026-41284, CVE-2026-41293,
             CVE-2026-42498, CVE-2026-43512 through CVE-2026-43515,
             CVE-2026-53404, CVE-2026-55276, CVE-2026-55956, CVE-2026-65182,
             CVE-2026-65637, CVE-2026-65905, CVE-2026-68525. -->
        <jackson-bom.version>2.21.7</jackson-bom.version>
        <log4j2.version>2.25.5</log4j2.version>
        <tomcat.version>10.1.59</tomcat.version>
        <archunit.version>1.4.1</archunit.version>
        <!--
            Numer laboratorium, którego reguły projektu są aktywne.
            Lokalnie podnosisz go sam na początku każdego laboratorium.
            W GitHub Actions tag lab-N uruchamia reguły laboratorium N.
        -->
        <lab>2</lab>
    </properties>
    <dependencies>
        <!-- LAB 02: JPA + H2 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- LAB 05: REST API (konsola H2 też potrzebuje serwera WWW) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Testy -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Reguły projektu od LAB 03: testy architektury -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <lab>${lab}</lab>
                        <project.dir>${project.basedir}</project.dir>
                    </systemPropertyVariables>
                    <trimStackTrace>true</trimStackTrace>
                    <!-- w raportach nazwy z @DisplayName (np. "R1.03 …"), czytelne w podsumowaniu GitHub Actions -->
                    <statelessTestsetReporter implementation="org.apache.maven.plugin.surefire.extensions.junit5.JUnit5Xml30StatelessReporter">
                        <usePhrasedTestSuiteClassName>true</usePhrasedTestSuiteClassName>
                        <usePhrasedTestCaseMethodName>true</usePhrasedTestCaseMethodName>
                    </statelessTestsetReporter>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
